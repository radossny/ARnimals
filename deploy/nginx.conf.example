# Przykład konfiguracji nginx dla aplikacji „Wizyta zwierzaka".
# Aplikacja działa wyłącznie po HTTPS: getUserMedia i WebXR są ograniczone do
# bezpiecznych kontekstów (wyjątkiem jest tylko http://localhost do testów).

server {
    listen 80;
    listen [::]:80;
    server_name zwierzak.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name zwierzak.example;

    ssl_certificate     /etc/letsencrypt/live/zwierzak.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zwierzak.example/privkey.pem;

    root /var/www/zwierzak;
    index index.html;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; connect-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=(), xr-spatial-tracking=(self), accelerometer=(self), gyroscope=(self), magnetometer=(), payment=(), usb=(), midi=(), display-capture=(), browsing-topics=(), interest-cohort=()" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;

    # Prawidłowe typy MIME dla modeli 3D
    types {
        model/gltf-binary  glb;
        model/vnd.usdz+zip usdz;
        application/manifest+json webmanifest;
    }

    gzip on;
    gzip_types text/css application/javascript application/manifest+json image/svg+xml;

    # Ważne: w nginx add_header w bloku location nadpisuje wszystkie
    # add_header z bloku server. Dlatego używamy tu wyłącznie "expires".
    location /icons/  { expires 1y; }
    location /models/ { expires 1y; }

    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
